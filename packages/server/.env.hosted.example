# Reference only: do not use local/desktop mode behind a public proxy.
# Hosted file saves remain disabled until per-user storage is implemented.
NODE_ENV=production
APP_MODE=hosted
DESKTOP_MODE=false
HOST=127.0.0.1
PORT=3001
# Supply a unique random private value with at least 32 characters.
JWT_SECRET=
# Replace with the exact HTTPS frontend origin; never use a wildcard.
CORS_ORIGINS=https://replace-before-use.invalid
# Supply a separate test database before testing any hosted startup.
# DATABASE_URL=
